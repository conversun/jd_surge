#!name=JD Cookie Sync to Qinglong
#!desc=Auto sync JD cookies to Qinglong panel when using JD app
#!system=ios

[Script]
# 拦截京东 API 请求，提取 Cookie 并同步到青龙
#
# 注意：京东 2026-09 起把 functionId 从 URL query 挪进了 POST 请求体，
# URL 只剩 /client.action?（空 query），旧版的 functionId 白名单正则命中数恒为 0。
# 因此改为匹配 client.action 路径本身，由脚本内部用 UA + Cookie 过滤。
#
# timeout 必须大于脚本内 REQUEST_TIMEOUT × 串行请求数，否则内部超时保护永远不会生效
jd_cookie_sync = type=http-request,pattern=^https?:\/\/api\.m\.jd\.com\/client\.action,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/conversun/jd_surge/main/jd_cookie_sync.js,timeout=20

[MITM]
hostname = %APPEND% api.m.jd.com
